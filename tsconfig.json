{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // vitest resolves like a bundler, so relative imports need no `.js`
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["test/**/*.ts", "vitest.config.mts", "scripts/**/*.mjs"],
  // the fixture app is a Next.js project with its own tsconfig
  "exclude": ["test/e2e/fixtures"]
}
