{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // bundled by tsdown, so resolve like a bundler instead of requiring `.js` on relative imports
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "client.d.ts", "tsdown.config.ts"]
}
