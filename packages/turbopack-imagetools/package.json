{
  "name": "turbopack-imagetools",
  "version": "0.0.0",
  "description": "Build-time image transforms for Next.js with Turbopack: import './a.jpg?w=400;800&format=webp&as=srcset' and get optimized files, no image server needed.",
  "keywords": [
    "avif",
    "imagetools",
    "next",
    "nextjs",
    "responsive-images",
    "sharp",
    "srcset",
    "static-export",
    "turbopack",
    "webp"
  ],
  "homepage": "https://github.com/awdr74100/turbopack-imagetools#readme",
  "bugs": {
    "url": "https://github.com/awdr74100/turbopack-imagetools/issues"
  },
  "license": "MIT",
  "author": "Roya <a78945612385238@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awdr74100/turbopack-imagetools.git",
    "directory": "packages/turbopack-imagetools"
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./loader": "./dist/loader.cjs",
    "./asset-loader": "./dist/asset-loader.cjs",
    "./client": {
      "types": "./client.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "imagetools-core": "^12.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "next": "^16.4.5",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7"
  },
  "peerDependencies": {
    "next": ">=16.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
