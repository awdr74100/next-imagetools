{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "promise",
    "oxc",
    "react",
    "nextjs",
    "node",
    "vitest",
    "jsdoc",
    "eslint"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off"
  },
  "env": {
    "node": true,
    "browser": true
  },
  "rules": {
    "no-console": "off",
    "no-debugger": "error",
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-default-export": "off",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "nextjs/no-img-element": "off",
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": ["expect", "expect.poll", "verify*", "buildAndVerify"]
      }
    ],
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/test/**", "**/*.test.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/loader.ts", "src/asset-loader.ts"],
      "rules": {
        "oxc/no-this-in-exported-function": "off"
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/.next/**", "**/out/**", "**/next-env.d.ts"]
}
